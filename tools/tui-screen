#!/usr/bin/env python3
"""Render the live TUI to plain text, for eyes or for a diff.

    tools/tui-screen [tab-presses]     0=Devices 1=Streams 2=Rules 3=Events

The TUI has NO tests — 'make gui-test' is GTK-only via AT-SPI, and ratatui
draws into a terminal nothing else can read. This is the first thing that can
look at it at all.

# Two traps, both hit on 2026-09-01

A pty from pty.fork() has size **0x0**, and ratatui renders nothing into a
zero-size terminal. It emits the alternate-screen and cursor-hide sequences
and then draws empty frames forever, which reads exactly like a hung or broken
TUI. TIOCSWINSZ must be set on the master fd before anything is captured.

And ratatui **redraws in place** with cursor positioning, so concatenating the
raw output does not give you a screen — it gives you every frame smeared
together, and grepping it finds fragments of frames that never existed. Hence
the replay below: CUP/ED/EL applied to a grid, so what you print is the final
frame as a human would have seen it.

Not part of 'make check': it needs a running daemon, and a gate that fails on
a headless box teaches you to skip the gate.
"""
import os, pty, time, select, fcntl, termios, struct, re, sys

ROWS, COLS = 45, 190

def render(keys, settle=2.0):
    pid, fd = pty.fork()
    if pid == 0:
        os.environ.update(TERM="xterm-256color")
        # Absolute: this tool is run from anywhere, and a relative path
        # silently execs whatever happens to be under the caller's cwd.
        exe = os.environ.get("HWPRIVACY_TUI") or os.path.join(
            os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
            "target/release/hwprivacy-tui",
        )
        os.execvp(exe, [exe])
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", ROWS, COLS, 0, 0))
    buf = b""
    def drain(sec):
        nonlocal buf
        end = time.time() + sec
        while time.time() < end:
            r,_,_ = select.select([fd], [], [], 0.2)
            if r:
                try:
                    d = os.read(fd, 65536)
                    if not d: return
                    buf += d
                except OSError: return
    drain(2.5)
    for k in keys:
        os.write(fd, k); drain(1.5)
    drain(settle)
    os.kill(pid, 9); os.waitpid(pid, 0)

    grid = [[" "]*COLS for _ in range(ROWS)]
    cy = cx = 0
    i = 0
    s = buf.decode("utf-8", "replace")
    while i < len(s):
        c = s[i]
        if c == "\x1b":
            m = re.match(r"\x1b\[([0-9;?]*)([a-zA-Z])", s[i:])
            if not m:
                i += 1; continue
            params, cmd = m.group(1), m.group(2)
            nums = [int(x) for x in params.split(";") if x.isdigit()]
            if cmd == "H":
                cy = (nums[0]-1) if len(nums) > 0 else 0
                cx = (nums[1]-1) if len(nums) > 1 else 0
            elif cmd == "J":
                grid = [[" "]*COLS for _ in range(ROWS)]; cy = cx = 0
            elif cmd == "K":
                for x in range(cx, COLS): grid[cy][x] = " "
            i += m.end(); continue
        if c == "\n": cy = min(cy+1, ROWS-1); i += 1; continue
        if c == "\r": cx = 0; i += 1; continue
        if 0 <= cy < ROWS and 0 <= cx < COLS and c.isprintable():
            grid[cy][cx] = c; cx += 1
        i += 1
    return ["".join(r).rstrip() for r in grid]

keys = [b"\t"] * int(sys.argv[1]) if len(sys.argv) > 1 else []
for line in render(keys):
    if line.strip(): print(line[:190])
