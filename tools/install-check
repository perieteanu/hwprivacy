#!/usr/bin/env python3
"""
hwprivacy — assert that what gets installed is what the manifest declares.

WHY THIS EXISTS
---------------
As of 2026-09-07 `make install` had NEVER BEEN RUN, and no .deb had ever been
built. Not on a hosted runner, not in a container, not on the developer's own
machine — which got its working install by accretion over months, binary by
binary, rather than by executing the target. So the repo shipped two install
paths that nothing had ever exercised, in a project whose entire documented
pathology is a claim drifting away from the machine.

Both were broken in ways nobody could have known without running them:

  - debian/hwprivacy-daemon.install DECLARED usr/share/hwprivacy/presets/*.toml
    and debian/rules staged the presets nowhere, so dh_install would have
    matched nothing and the package build would have failed.
  - debian/rules installed straight into debian/<pkg>/ with its own second copy
    of every path, which both duplicated `make install` and could not coexist
    with the very manifests sitting beside it.

CI proves the code builds and the tests pass. It said nothing about whether a
stranger running the documented command ends up with the right files.

THE MANIFEST IS NOT WRITTEN HERE
--------------------------------
The expected file list is parsed from debian/*.install, which already declares
every installed path and is a file a human reads. Writing a third list would
recreate the exact failure being guarded against — the failure mode is never
"the check was too weak", it is "two lists that were supposed to agree quietly
stopped agreeing". Both modes below read that same one manifest, which is the
whole point: the Makefile and the .deb are held to a single source of truth.

Extras are failures, not warnings: a file no manifest declares is a file the
package will not ship.

TWO MODES
---------
    --destdir DIR    a tree staged by `make install DESTDIR=DIR`
    --deb-dir DIR    the built .deb files; each is checked against ITS OWN
                     debian/<pkg>.install, so a file landing in the wrong
                     binary package is caught, not just a missing one

DEFAULT PREFIX ONLY
-------------------
The debian manifests are /usr-relative and `install-lsm` hardcodes
/usr/lib/systemd/system for the system unit, so this checks a default-prefix
install and takes no --prefix. Per the house rule that a check is added only
after something has actually gone wrong, a PREFIX-aware version can be written
the first time a non-default prefix matters.

Usage:
    tools/install-check --destdir DIR          human
    tools/install-check --deb-dir ..           after dpkg-buildpackage
    tools/install-check --destdir DIR --json   for Claude

Read-only. Exit 0 clean, 1 on a real failure, 2 when it cannot run at all — an
empty or missing tree is never reported as a pass.
"""

import argparse
import fnmatch
import glob as globmod
import json
import os
import stat
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

EXEC_DIR = "usr/bin"
EXEC_MODE = 0o755
DATA_MODE = 0o644

# debhelper puts these in every binary package. They are not declared by any
# .install file and never should be — dh_installdocs and dh_installchangelogs
# own them. Anything ELSE undeclared is a real finding.
DH_OWNED = ("usr/share/doc/",)

failures = []
passes = []


def fail(check, path, problem):
    failures.append({"check": check, "file": path, "problem": problem})


def ok(msg):
    passes.append(msg)


def cannot_run(why):
    """Exit 2. A thing we could not inspect must never read as a pass."""
    print(f"hwprivacy install-check — CANNOT RUN\n\n  {why}", file=sys.stderr)
    sys.exit(2)


def read_manifest(pkg):
    """Declared paths for one binary package, from debian/<pkg>.install."""
    path = os.path.join(ROOT, "debian", f"{pkg}.install")
    if not os.path.exists(path):
        return None
    out = []
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if line and not line.startswith("#"):
                out.append(line)
    return out


def compare(label, declared, present, dh_owned_ok):
    """The four checks, run identically over a staged tree or a .deb.

    declared  list of (manifest name, pattern)
    present   {relative path: mode int or None}
    """
    matched = set()
    missing = 0
    for src, pattern in declared:
        if any(c in pattern for c in "*?["):
            hits = [rel for rel in present if fnmatch.fnmatch(rel, pattern)]
            if not hits:
                missing += 1
                fail("missing", pattern,
                     f"[{label}] declared by debian/{src}, matched nothing")
            matched.update(hits)
        elif pattern in present:
            matched.add(pattern)
        else:
            missing += 1
            fail("missing", pattern, f"[{label}] declared by debian/{src}, absent")
    if not missing:
        ok(f"{label}: every declared path is present ({len(declared)} entries)")

    extras = sorted(r for r in set(present) - matched
                    if not (dh_owned_ok and r.startswith(DH_OWNED)))
    for rel in extras:
        fail("undeclared", rel,
             f"[{label}] present but declared by no debian/*.install")
    if not extras:
        ok(f"{label}: nothing present that the manifest does not declare "
           f"({len(present)} files)")

    bad = 0
    for rel, mode in sorted(present.items()):
        if mode is None or (dh_owned_ok and rel.startswith(DH_OWNED)):
            continue
        want = EXEC_MODE if rel.startswith(EXEC_DIR + "/") else DATA_MODE
        if mode != want:
            bad += 1
            fail("mode", rel, f"[{label}] is {mode:04o}, expected {want:04o}")
    if not bad:
        ok(f"{label}: every file carries the mode its kind requires")


ap = argparse.ArgumentParser()
g = ap.add_mutually_exclusive_group(required=True)
g.add_argument("--destdir", help="a tree staged by make install DESTDIR=...")
g.add_argument("--deb-dir", help="directory holding the built .deb files")
ap.add_argument("--json", action="store_true", help="machine-readable output")
args = ap.parse_args()

manifests = sorted(globmod.glob(os.path.join(ROOT, "debian", "*.install")))
if not manifests:
    cannot_run("no debian/*.install files — there is no manifest to check against")

measured = {}

# ══════════════════════════════════════════════════════════════════
# MODE 1: a staged tree.  One manifest, the union of all of them.
# ══════════════════════════════════════════════════════════════════
if args.destdir:
    DESTDIR = os.path.abspath(args.destdir)
    if not os.path.isdir(DESTDIR):
        cannot_run(f"no such directory: {DESTDIR}\n"
                   f"  stage one first:  make install DESTDIR={DESTDIR}")

    present = {}
    for dirpath, _d, filenames in os.walk(DESTDIR):
        for f in filenames:
            full = os.path.join(dirpath, f)
            present[os.path.relpath(full, DESTDIR)] = stat.S_IMODE(os.stat(full).st_mode)
    if not present:
        cannot_run(f"{DESTDIR} exists but contains no files\n"
                   f"  stage one first:  make install DESTDIR={DESTDIR}")

    declared = []
    for m in manifests:
        for line in read_manifest(os.path.basename(m)[:-len(".install")]) or []:
            declared.append((os.path.basename(m), line))

    compare("staged tree", declared, present, dh_owned_ok=False)

    bins = sorted(r for r in present if r.startswith(EXEC_DIR + "/"))
    bad = 0
    for rel in bins:
        full = os.path.join(DESTDIR, rel)
        if os.path.getsize(full) == 0:
            bad += 1
            fail("binary", rel, "is zero bytes")
            continue
        with open(full, "rb") as fh:
            if fh.read(4) != b"\x7fELF":
                bad += 1
                fail("binary", rel, "is not an ELF executable")
    if bins and not bad:
        ok(f"all {len(bins)} installed binaries are non-empty ELF")

    measured = {"mode": "destdir", "destdir": DESTDIR,
                "present": len(present), "declared": len(declared)}
    headline = (f"{len(present)} files staged, {len(declared)} declared "
                f"across {len(manifests)} manifests")

# ══════════════════════════════════════════════════════════════════
# MODE 2: the built .deb files.  Each package against ITS OWN manifest,
#         so a file landing in the WRONG package is caught too.
# ══════════════════════════════════════════════════════════════════
else:
    DEBDIR = os.path.abspath(args.deb_dir)
    debs = sorted(globmod.glob(os.path.join(DEBDIR, "*.deb")))
    debs = [d for d in debs if "-dbgsym_" not in os.path.basename(d)]
    if not debs:
        cannot_run(f"no .deb files in {DEBDIR}\n"
                   f"  build them first:  dpkg-buildpackage -us -uc -b")

    total = 0
    for deb in debs:
        pkg = os.path.basename(deb).split("_")[0]
        lines = read_manifest(pkg)
        if lines is None:
            fail("package", os.path.basename(deb),
                 f"built a package with no debian/{pkg}.install to check it against")
            continue

        # dpkg-deb -c needs no root and reads the archive directly.
        out = subprocess.run(["dpkg-deb", "-c", deb],
                             capture_output=True, text=True, check=True).stdout
        present = {}
        for line in out.splitlines():
            parts = line.split(None, 5)
            if len(parts) < 6 or parts[0].startswith("d"):
                continue                      # directories carry no manifest entry
            perms, name = parts[0], parts[5]
            name = name.split(" -> ")[0].lstrip("./")
            if not name:
                continue
            mode = 0
            for i, ch in enumerate(perms[1:10]):
                if ch != "-":
                    mode |= 1 << (8 - i)
            present[name] = mode
        total += len(present)
        compare(pkg, [(f"{pkg}.install", l) for l in lines], present,
                dh_owned_ok=True)

    measured = {"mode": "deb", "deb_dir": DEBDIR, "packages": len(debs),
                "files": total}
    headline = f"{len(debs)} packages, {total} files, checked against their own manifests"

# ══════════════════════════════════════════════════════════════════
# Report.
# ══════════════════════════════════════════════════════════════════
if args.json:
    print(json.dumps({"ok": not failures, "failures": failures,
                      "passes": passes, "measured": measured}, indent=2))
else:
    print(f"hwprivacy install-check — measured: {headline}")
    print()
    for p in passes:
        print(f"  ok    {p}")
    if failures:
        print()
        for f in failures:
            print(f"  FAIL  [{f['check']}] {f['file']}")
            print(f"        {f['problem']}")
        print(f"\n{len(failures)} problem(s) between what is installed and what is declared.")
    else:
        print("\nWhat is installed matches what the manifest declares.")

sys.exit(1 if failures else 0)
